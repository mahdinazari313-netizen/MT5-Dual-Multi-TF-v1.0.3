<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/triggerHistoryRecyclerView" android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:padding="8dp" />
    <TextView android:id="@+id/triggerHistoryEmptyText" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:text="@string/empty_trigger_history" android:textSize="16sp" android:visibility="gone" />
</FrameLayout>
